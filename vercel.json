{
    "routes": [
        {
            "src": "/service-innovate/(.*)",
            "dest": "/"
        },
        {
            "src": "/service-tech/(.*)",
            "dest": "/"
        },
        {
            "src": "/service-social-savvy/(.*)",
            "dest": "/"
        },
        {
            "src": "/about-us",
            "dest": "/"
        },
        {
            "src": "/our-team",
            "dest": "/"
        },
        {
            "src": "/contact-us",
            "dest": "/"
        },
        {
            "src": "/team-single/(.*)",
            "dest": "/"
        },
        {
            "src": "/[^.]+",
            "dest": "/"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}